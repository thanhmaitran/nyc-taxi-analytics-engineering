  create view "warehouse"."main"."stg_yellow_taxi__dbt_tmp" as (
    

with source_data as (

    select
        *,
        regexp_extract(filename, '[^/\\]+$') as source_file_name
    from "warehouse"."main"."raw_yellow_taxi"

),

renamed as (

    select
        md5(source_file_name || ':' || cast(file_row_number as varchar)) as trip_record_key,

        source_file_name as source_file,
        regexp_extract(source_file_name, '(\d{4}-\d{2})', 1) as source_period,
        file_row_number as source_row_number,

        try_cast("VendorID" as integer) as vendor_id,
        try_cast("tpep_pickup_datetime" as timestamp) as pickup_datetime,
        try_cast("tpep_dropoff_datetime" as timestamp) as dropoff_datetime,
        try_cast("passenger_count" as integer) as passenger_count,
        try_cast("trip_distance" as decimal(18,2)) as trip_distance,
        try_cast("RatecodeID" as integer) as rate_code_id,
        try_cast("PULocationID" as integer) as pickup_location_id,
        try_cast("DOLocationID" as integer) as dropoff_location_id,
        try_cast("payment_type" as integer) as payment_type,
        try_cast("fare_amount" as decimal(18,2)) as fare_amount,
        try_cast("tip_amount" as decimal(18,2)) as tip_amount,
        try_cast("total_amount" as decimal(18,2)) as total_amount,
        try_cast("Airport_fee" as decimal(18,2)) as airport_fee,
        try_cast("congestion_surcharge" as decimal(18,2)) as congestion_surcharge,
        try_cast("cbd_congestion_fee" as decimal(18,2)) as cbd_congestion_fee

    from source_data

)

select * from renamed
  );

