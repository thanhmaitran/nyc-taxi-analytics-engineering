    create temporary table
      "mart_quality_reconciliation__dbt_tmp20261020221745161786"
  
    
    as (
      


with validated as (

    select
        source_file,
        source_period,
        count(*) as source_rows,
        count(pickup_datetime) as parsed_pickup_rows,
        count_if(is_valid) as valid_rows,
