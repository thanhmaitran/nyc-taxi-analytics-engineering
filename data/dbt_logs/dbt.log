    from "warehouse"."main"."int_trip_validated"
    
        where 
    source_file not in (select distinct t.source_file from "warehouse"."main"."mart_quality_reconciliation" as t)
    

    
    group by source_file, source_period

),

fact as (

    select
        source_file,
        count(*) as fact_rows
    from "warehouse"."main"."fact_trips"
    group by source_file

)

select
    v.*,
    coalesce(f.fact_rows, 0) as fact_rows,
    round(100.0 * v.quarantined_rows / v.source_rows, 4) as quarantine_pct
from validated as v
left join fact as f on v.source_file = f.source_file
    );
    
  
  
